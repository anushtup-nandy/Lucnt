# T4-12: `Settings` now uses `extra="forbid"`, so an unrecognised key here is a
# startup error rather than a silently ignored one. Every variable below is
# declared in `src/lucnt_api/config.py`; adding one there is the price of
# documenting it here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lucnt
REDIS_URL=redis://localhost:6379/0
# REQUIRED, and no longer defaults to `development` (T4-12). It used to, which
# meant an unset ENVIRONMENT in production served `/docs`, `/redoc` and
# `/openapi.json` — the whole financial API surface — publicly. One of
# development | staging | production; anything else fails startup.
ENVIRONMENT=development

# REQUIRED (P7.0). This is the HS256 key that signs dashboard access and refresh
# tokens (`security.py`). It was optional under T4-9 only because nothing read
# it; the auth feature it was reserved for now exists, so it is required and has
# no default — a signing key with a dev default is how dev secrets reach
# production. Outside development it must be at least 32 characters and must not
# be the value below, which is in every checkout.
#
# Rotating it invalidates every live dashboard session (all tokens fail
# signature verification and every browser is bounced to /login). That is the
# only revocation mechanism P7.0 has: refresh tokens are stateless.
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev_secret_change_me_before_deploying_lucnt

# --- Dashboard auth (P7.0) --------------------------------------------------
# Exact browser origins allowed to call the API with credentials. NEVER a
# wildcard: `allow_credentials=True` is needed for the refresh cookie, and the
# two together are rejected by the CORS spec anyway. Comma-separated.
CORS_ORIGINS=http://localhost:5173
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7

# --- Tests (T4-12) ----------------------------------------------------------
# Point the suite at a throwaway database. Unset, it falls back to DATABASE_URL
# with a warning: fixtures roll back, but CI's `alembic downgrade base` does not.
# Rejected outside development.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lucnt_test

# --- Observability (T4-4) ---------------------------------------------------
# LOG_LEVEL=INFO
# json | console. Unset = console in development, JSON everywhere else.
# LOG_FORMAT=json
# `/metrics` is unauthenticated and denied at the edge by infra/nginx/nginx.conf.
# METRICS_ENABLED=true
# Requires the optional extra: pip install '.[sentry]'. Unset = never imported.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# Lifespan DB ping + "schema is at the migration head" assertion. Leave on.
# STARTUP_CHECKS_ENABLED=true

# NOT WIRED YET, but declared in `config.py` so `extra="forbid"` accepts them.
# Kept as the intended shape for M3 invoice/email ingestion; mailpit runs in
# compose for when it lands. Nothing under `src/` reads these today.
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Connection pool & timeouts (T3-4) -------------------------------------
# Defaults live in `src/lucnt_api/config.py`; override per environment. The
# total pool (size + overflow) is multiplied by the number of gunicorn workers,
# so keep it well under Postgres `max_connections`. `main.py` pins the AnyIO
# worker-thread limiter to size+overflow, so raising these raises request
# concurrency too.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800
# DB_CONNECT_TIMEOUT=10
# DB_STATEMENT_TIMEOUT_MS=30000

# --- Rate limiting (T3-7) ---------------------------------------------------
# Shared counters in Redis (REDIS_URL above), so limits stay correct whatever the
# gunicorn worker count. An unreachable Redis fails OPEN — it logs a warning and
# admits the request, because rate limiting is a mitigation, not an authorization
# boundary, and a cache blip must not take down authorize().
#
# DEPLOYMENT REQUIREMENT: the auth-failure bucket is keyed on the client IP taken
# from the socket. Once nginx fronts the app it MUST set `set_real_ip_from` /
# `real_ip_header`, or every client collapses into one bucket and this becomes a
# lockout for all of them.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT_PER_MINUTE=600            # per API key, ordinary calls
# RATE_LIMIT_AUTH_FAILURE_PER_MINUTE=20        # per IP, failed auth only
# RATE_LIMIT_EXPENSIVE_PER_MINUTE=5            # /recon/scan, /intelligence/recompute
# RATE_LIMIT_REDIS_TIMEOUT=0.25                # seconds before failing open

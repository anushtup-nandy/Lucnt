# Unknown keys fail startup (`extra="forbid"`); all are declared in config.py.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lucnt
REDIS_URL=redis://localhost:6379/0
# REQUIRED: development | staging | production. Only development serves /docs.
ENVIRONMENT=development

# REQUIRED: signs dashboard JWTs. CHANGE IT outside development (>=32 chars, not
# this value). Rotating it logs out every session. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev_secret_change_me_before_deploying_lucnt

# --- Dashboard auth ---------------------------------------------------------
# Comma-separated exact origins; NEVER a wildcard (credentials are allowed).
CORS_ORIGINS=http://localhost:5173
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7

# --- Tests ------------------------------------------------------------------
# Throwaway DB for the suite; falls back to DATABASE_URL with a warning.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lucnt_test

# --- Observability ----------------------------------------------------------
# LOG_LEVEL=INFO
# json | console. Unset = console in development, JSON everywhere else.
# LOG_FORMAT=json
# /metrics is unauthenticated; nginx denies it at the edge.
# METRICS_ENABLED=true
# Requires pip install '.[sentry]'.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# DB ping + schema-at-head check on startup. Leave on.
# STARTUP_CHECKS_ENABLED=true

# Not used yet (reserved for email ingestion).
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Connection pool & timeouts --------------------------------------------
# (size + overflow) × workers must stay under Postgres max_connections; it also
# sets per-worker request concurrency.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800
# DB_CONNECT_TIMEOUT=10
# DB_STATEMENT_TIMEOUT_MS=30000

# --- Rate limiting ----------------------------------------------------------
# Counters live in Redis; an unreachable Redis fails OPEN (logged).
# Behind a proxy, nginx MUST set real_ip, or all clients share one auth-failure bucket.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT_PER_MINUTE=600            # per API key, ordinary calls
# RATE_LIMIT_AUTH_FAILURE_PER_MINUTE=20        # per IP, failed auth only
# RATE_LIMIT_EXPENSIVE_PER_MINUTE=5            # /recon/scan, /intelligence/recompute
# RATE_LIMIT_REDIS_TIMEOUT=0.25                # seconds before failing open

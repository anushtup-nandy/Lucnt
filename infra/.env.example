# Compose-level variables. Copy to `.env` in this directory; compose
# reads it automatically. These configure the *containers*; the application's own
# settings live in `backend/.env` (see `backend/.env.example`).
#
# Everything here has a working default in `docker-compose.yml`, so a fresh
# checkout still comes up with no file at all. Override when you need to.

# --- Development stack (docker-compose.yml) ---------------------------------
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=lucnt
# Change the host port if 5432/6379 is already taken locally. Both bind to
# 127.0.0.1 only — see the comment at the top of docker-compose.yml.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# LOG_FORMAT=console
# WEB_CONCURRENCY=2

# --- Deployed stack (docker-compose.prod.yml) -------------------------------
# Use a SEPARATE file for these (`--env-file .env.prod`) and never commit it.
# Each is declared `${VAR:?…}` in the prod compose file, so a missing one fails
# `up` with an explanatory message instead of starting on a placeholder.
#
# Prefer a managed Postgres: this stack cannot give you backups or PITR, and a
# ledger is the wrong place to find that out.
# DATABASE_URL=postgresql://lucnt:<strong-password>@db.internal:5432/lucnt
# Directory on the host holding fullchain.pem and privkey.pem, mounted read-only.
# TLS_CERT_DIR=/etc/letsencrypt/live/api.example.com
# ENVIRONMENT=production
# Immutable tag or digest of the image to run. Avoid `latest` in production —
# a restart would silently pick up whatever was built most recently.
# BACKEND_IMAGE=ghcr.io/<org>/lucnt-backend:<git-sha>
# Raise only together with Postgres max_connections: the ceiling is
# WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# WEB_CONCURRENCY=2
# LOG_LEVEL=INFO
# Requires the image to be built with the `[sentry]` extra.
# SENTRY_DSN=

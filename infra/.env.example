# Compose variables: copy to `.env` here. App settings live in backend/.env.
# All dev values have defaults in docker-compose.yml.

# --- Development stack (docker-compose.yml) ---------------------------------
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=lucnt
# Host ports (bound to 127.0.0.1).
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# LOG_FORMAT=console
# WEB_CONCURRENCY=2

# --- Deployed stack (docker-compose.prod.yml) -------------------------------
# Put these in a separate `--env-file .env.prod`; never commit it.
# Prefer a managed Postgres (backups, PITR).
# DATABASE_URL=postgresql://lucnt:<strong-password>@db.internal:5432/lucnt
# Host dir with fullchain.pem and privkey.pem.
# TLS_CERT_DIR=/etc/letsencrypt/live/api.example.com
# ENVIRONMENT=production
# Immutable tag or digest; avoid `latest` in production.
# BACKEND_IMAGE=ghcr.io/<org>/lucnt-backend:<git-sha>
# DB connections = WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# WEB_CONCURRENCY=2
# LOG_LEVEL=INFO
# Requires the image to be built with the `[sentry]` extra.
# SENTRY_DSN=
